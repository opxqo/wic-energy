# Web: copy to apps/web/.env; CLI: copy to apps/cli/.env if needed.
# No account/password configuration is required.
HOST=127.0.0.1
PORT=3000
WIC_BASE_URL=http://sd.wic.edu.cn/mobile/
WIC_TIMEOUT_MS=15000
# Web only, set both to enable TLS:
SSL_CERT=
SSL_KEY=
# CLI only, optional override:
# WIC_SESSION_FILE=/absolute/path/session.json
